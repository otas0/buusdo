# Copy to scripts/codesign.env (gitignored) on the signing machine.
# Never commit real values.

# macOS — must match `security find-identity -v -p codesigning`
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# Created via: xcrun notarytool store-credentials "buusdo-notary" ...
NOTARY_PROFILE="buusdo-notary"

# Windows (Git Bash / MSYS) — Authenticode (separate from Apple)
# SIGNTOOL="/c/Program Files (x86)/Windows Kits/10/bin/10.0.22621.0/x64/signtool.exe"
# TIMESTAMP_URL="http://timestamp.digicert.com"
